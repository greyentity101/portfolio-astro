---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="bg-brand-bg-elevated border-t border-brand-border/50">
  <div class="container py-16">
    <div class="grid lg:grid-cols-4 gap-10 lg:gap-12">
      <div class="lg:col-span-2">
        <a href={base} class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-accent to-brand-violet flex items-center justify-center font-mono font-bold text-brand-bg text-lg">MK</div>
          <span class="font-bold text-xl tracking-tight">Mohit Kumar</span>
        </a>
        <p class="text-brand-text-secondary max-w-sm mb-6 leading-relaxed">Software Developer & AI Researcher. Building tools for healthcare — offline-first, privacy-respecting, zero-bloat.</p>
        <div class="flex gap-4">
          <a href="https://github.com/greyentity101" target="_blank" rel="noopener" class="text-brand-text-secondary hover:text-brand-accent transition-colors" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://linkedin.com/in/mohit-kumar-ai" target="_blank" rel="noopener" class="text-brand-text-secondary hover:text-brand-accent transition-colors" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.141-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="mailto:mohit.kumar@example.com" class="text-brand-text-secondary hover:text-brand-accent transition-colors" aria-label="Email">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-semibold mb-4 text-brand-text">Projects</h4>
        <nav class="space-y-3">
          <a href={`${base}projects/radiology-atlas`} class="text-brand-text-secondary hover:text-brand-accent transition-colors text-sm block">RadiologyAtlas</a>
          <a href={`${base}projects/google-apps-launcher`} class="text-brand-text-secondary hover:text-brand-accent transition-colors text-sm block">Google Apps Launcher</a>
          <a href={`${base}projects/ai-interventional`} class="text-brand-text-secondary hover:text-brand-accent transition-colors text-sm block">AI in Interventional Procedures</a>
        </nav>
      </div>

      <div>
        <h4 class="font-semibold mb-4 text-brand-text">Connect</h4>
        <nav class="space-y-3">
          <a href="mailto:mohit.kumar@example.com" class="text-brand-text-secondary hover:text-brand-accent transition-colors text-sm block">Email</a>
          <a href="https://github.com/greyentity101" target="_blank" rel="noopener" class="text-brand-text-secondary hover:text-brand-accent transition-colors text-sm block">GitHub</a>
          <a href="https://linkedin.com/in/mohit-kumar-ai" target="_blank" rel="noopener" class="text-brand-text-secondary hover:text-brand-accent transition-colors text-sm block">LinkedIn</a>
        </nav>
      </div>
    </div>

    <div class="border-t border-brand-border/50 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-brand-muted text-sm">© 2025 Mohit Kumar. No tracking, no analytics, no cookies.</p>
      <div class="flex gap-6 text-sm">
        <a href={`${base}rss.xml`} class="text-brand-muted hover:text-brand-accent transition-colors">RSS</a>
        <a href={`${base}sitemap-index.xml`} class="text-brand-muted hover:text-brand-accent transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>