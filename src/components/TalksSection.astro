---
import type { getCollection } from 'astro:content';

interface Props {
  talks: Awaited<ReturnType<typeof getCollection<'talks'>>>;
}
const { talks } = Astro.props;
---
<section id="talks" class="section">
  <div class="container">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <div class="dot-block w-2 h-2 rounded-full bg-brand-green"></div>
          <span class="text-brand-green text-sm font-semibold uppercase tracking-wider">Talks</span>
        </div>
        <h2 class="section-title">Speaking & presentations</h2>
      </div>
      <a href="/talks" class="btn-ghost text-sm">
        All talks
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>

    {talks.length === 0 ? (
      <div class="card text-center py-12">
        <div class="text-4xl mb-4">🎤</div>
        <p class="text-brand-text-secondary">Talks coming soon. I'm always looking for opportunities to share.</p>
      </div>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {talks.map(talk => (
          <a href={`/talks/${talk.slug}`} class="card group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-green to-brand-accent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative">
              <span class="tag">{talk.data.venue}</span>
              <h3 class="text-lg font-bold mt-3 mb-1 group-hover:text-brand-accent transition-colors">{talk.data.title}</h3>
              <p class="text-brand-muted text-sm">{talk.data.date}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</section>