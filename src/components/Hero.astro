---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const slices = Array.from({ length: 10 });
const contour = (seed: number) => `
  <ellipse cx="100" cy="100" rx="${58 - seed * 3}" ry="${44 - seed * 2}" fill="none" stroke="rgba(69,227,255,0.5)" stroke-width="1"/>
  <ellipse cx="100" cy="100" rx="${38 - seed * 2}" ry="${30 - seed}" fill="none" stroke="rgba(69,227,255,0.35)" stroke-width="1"/>
  <ellipse cx="100" cy="100" rx="${20 - seed}" ry="${16 - seed}" fill="rgba(69,227,255,0.08)" stroke="rgba(255,176,32,0.65)" stroke-width="1.2"/>
  <line x1="100" y1="14" x2="100" y2="186" stroke="rgba(69,227,255,0.22)" stroke-width="1"/>
  <line x1="14" y1="100" x2="186" y2="100" stroke="rgba(69,227,255,0.22)" stroke-width="1"/>
  <circle cx="100" cy="100" r="3" fill="#FFB020"/>
`;
---
<section class="relative overflow-hidden">
  <div class="grid-floor" aria-hidden="true"></div>

  <div class="container relative z-10 grid lg:grid-cols-[1.02fr_0.98fr] gap-14 items-center pt-28 pb-16 lg:pt-36 lg:pb-24">
    <div>
      <p class="eyebrow text-brand-accent mb-6">
        <span class="inline-block w-2 h-2 rounded-full bg-brand-accent" style="box-shadow: 0 0 12px rgba(255,176,32,0.9)"></span>
        Available for opportunities
      </p>

      <h1 class="font-display font-bold tracking-tight leading-[1.02] text-balance text-5xl sm:text-6xl xl:text-7xl">
        Building tools for<br />
        <span class="bg-gradient-to-r from-brand-accent to-brand-violet bg-clip-text text-transparent">healthcare</span>,<br />
        offline-first.
      </h1>

      <p class="text-brand-text-secondary text-lg lg:text-xl max-w-lg leading-relaxed mt-6">
        Software Developer & AI Researcher. Healthcare IT. Medical Imaging AI. PACS/DICOM workflows.
      </p>

      <div class="flex flex-wrap gap-4 mt-8">
        <a href={`${base}#projects`} class="btn-primary">
          View projects
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
        <a href={`${base}contact`} class="btn-ghost">Get in touch</a>
      </div>

      <dl class="flex flex-wrap gap-x-8 gap-y-3 mt-10 font-mono text-xs tracking-[0.18em] text-brand-muted uppercase">
        <div><dt class="sr-only">Projects</dt><dd><span class="text-brand-text font-semibold">15+</span> projects</dd></div>
        <div><dt class="sr-only">Domain</dt><dd>Healthcare AI</dd></div>
        <div><dt class="sr-only">Approach</dt><dd>Offline-first</dd></div>
        <div><dt class="sr-only">Tracking</dt><dd>Zero tracking</dd></div>
      </dl>
    </div>

    <div>
      <div class="scan-stage" id="scan-stage" aria-hidden="true">
        <div class="scan-stack" id="scan-stack">
          {slices.map((_, i) => (
            <div class="scan-slice" style={`--i:${i}`}>
              <svg viewBox="0 0 200 200" preserveAspectRatio="xMidYMid meet" set:html={contour(i % 4)} />
              {i % 3 === 0 && <span class="slice-tag">SL-{String(i + 1).padStart(2, '0')}</span>}
            </div>
          ))}
          <div class="scan-plane"></div>
        </div>
        <div class="scan-shadow"></div>
      </div>
      <p class="readout"><span class="pulse"></span> Axial stack · 10 slices · sweep active</p>
    </div>
  </div>
</section>
