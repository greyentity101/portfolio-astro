---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const navLinks = [
  { href: `${base}#projects`, label: 'Projects' },
  { href: `${base}#writing`, label: 'Writing' },
  { href: `${base}#talks`, label: 'Talks' },
  { href: `${base}#about`, label: 'About' },
];
---
<header class="fixed top-0 left-0 right-0 z-50 bg-brand-bg/80 backdrop-blur-xl border-b border-brand-border/50">
  <nav class="container flex items-center justify-between h-16 lg:h-18" aria-label="Main navigation">
    <a href={base} class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-accent to-brand-violet flex items-center justify-center font-mono font-bold text-brand-bg text-lg transition-transform duration-300 group-hover:scale-110">
        MK
      </div>
      <span class="hidden sm:block font-bold text-xl tracking-tight">Mohit Kumar</span>
    </a>

    <div class="hidden lg:flex items-center gap-8">
      {navLinks.map(link => (
        <a href={link.href} class="text-brand-text-secondary hover:text-brand-accent transition-colors duration-200 text-sm font-medium">{link.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-4">
      <button id="theme-toggle" class="p-2 rounded-xl bg-brand-card border border-brand-border hover:border-brand-accent/50 transition-all duration-200" aria-label="Toggle theme">
        <svg class="w-5 h-5 text-brand-text-secondary dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
        <svg class="w-5 h-5 text-brand-accent hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
      </button>

      <a href="https://github.com/greyentity101" target="_blank" rel="noopener" class="hidden sm:flex p-2 rounded-xl bg-brand-card border border-brand-border hover:border-brand-accent/50 transition-all duration-200" aria-label="GitHub">
        <svg class="w-5 h-5 text-brand-text-secondary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
      </a>

      <a href={`${base}contact`} class="btn-primary hidden sm:inline-flex">Get in touch</a>

      <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-xl bg-brand-card border border-brand-border" aria-label="Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
  </nav>
</header>