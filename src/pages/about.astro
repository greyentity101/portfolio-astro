---
import MainLayout from '../layouts/MainLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<MainLayout title="About" description="Background and interests of Mohit Kumar — Software Developer & AI Researcher.">
  <section id="about" class="section bg-brand-bg-elevated/50">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <div class="dot-block w-2 h-2 rounded-full bg-brand-violet"></div>
            <span class="text-brand-violet text-sm font-semibold uppercase tracking-wider">About</span>
          </div>
          <h1 class="section-title">Background &amp; interests</h1>
          <p class="text-brand-text-secondary text-lg leading-relaxed mt-4 mb-6">Software Developer & AI Researcher bridging radiotechnology with machine learning. Building tools that work offline, respect privacy, and actually help clinicians.</p>
          <div class="space-y-4 mb-8">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
              </div>
              <div>
                <h4 class="font-semibold mb-1">Medical Imaging AI</h4>
                <p class="text-brand-text-secondary text-sm">NPTEL AI for clinicians, Stanford/DeepLearning.AI healthcare specializations. PACS/DICOM workflows.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-violet/10 border border-brand-violet/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-brand-violet" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
              </div>
              <div>
                <h4 class="font-semibold mb-1">Local-first AI</h4>
                <p class="text-brand-text-secondary text-sm">Fast local inference on RTX 4050. Agentic architectures with clean memory management.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-green/10 border border-brand-green/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              </div>
              <div>
                <h4 class="font-semibold mb-1">Privacy &amp; ethics</h4>
                <p class="text-brand-text-secondary text-sm">No tracking, no analytics, no cookies. Zero-bloat, privacy-respecting tools for healthcare.</p>
              </div>
            </div>
          </div>
          <div class="flex flex-wrap gap-4">
            <a href="https://github.com/greyentity101" target="_blank" rel="noopener" class="btn-primary">GitHub</a>
            <a href={`${base}contact`} class="btn-ghost">Contact</a>
          </div>
        </div>
        <div class="relative">
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-4">
              <div class="card text-center p-6">
                <div class="text-3xl font-bold bg-gradient-to-r from-brand-accent to-brand-violet bg-clip-text text-transparent">5+</div>
                <div class="text-brand-muted text-sm mt-1">Years of experience</div>
              </div>
              <div class="card text-center p-6">
                <div class="text-3xl font-bold bg-gradient-to-r from-brand-green to-brand-accent bg-clip-text text-transparent">15+</div>
                <div class="text-brand-muted text-sm mt-1">Projects built</div>
              </div>
            </div>
            <div class="space-y-4 mt-8">
              <div class="card text-center p-6">
                <div class="text-3xl font-bold bg-gradient-to-r from-brand-violet to-brand-green bg-clip-text text-transparent">200+</div>
                <div class="text-brand-muted text-sm mt-1">Commits</div>
              </div>
              <div class="card text-center p-6">
                <div class="text-3xl font-bold bg-gradient-to-r from-brand-accent to-brand-green bg-clip-text text-transparent">Zero</div>
                <div class="text-brand-muted text-sm mt-1">Bloat &amp; tracking</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>