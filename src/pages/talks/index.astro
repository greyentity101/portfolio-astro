---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
const talks = await getCollection('talks');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<MainLayout title="Talks" description="Speaking and presentations by Mohit Kumar.">
  <div class="container py-12">
    <h1 class="section-title mb-4">Talks</h1>
    <p class="section-subtitle mb-10">Demos and presentations.</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {talks.map((t) => (
        <a href={`${base}talks/${t.slug}`} class="card group">
          <span class="tag">{t.data.venue}</span>
          <h3 class="text-lg font-bold mt-3 group-hover:text-brand-accent transition-colors">{t.data.title}</h3>
          <p class="text-brand-muted text-sm">{t.data.date}</p>
        </a>
      ))}
    </div>
  </div>
</MainLayout>
