---
import MainLayout from '../layouts/MainLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<MainLayout title="Not found" description="Page not found.">
  <div class="container max-w-2xl py-24 text-center">
    <h1 class="section-title mb-4">404</h1>
    <p class="section-subtitle mb-8 mx-auto">That page does not exist.</p>
    <a href={base} class="btn-primary">Back home</a>
  </div>
</MainLayout>
