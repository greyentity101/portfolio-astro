---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
const posts = await getCollection('blog');
---
<MainLayout title="Writing" description="Blog and articles by Mohit Kumar.">
  <div class="container py-12">
    <h1 class="section-title mb-4">Writing</h1>
    <p class="section-subtitle mb-10">Notes on healthcare AI and local-first tools.</p>
    <div class="grid md:grid-cols-2 gap-6">
      {posts.map((p) => (
        <a href={`/writing/${p.slug}`} class="card group">
          <span class="tag">{p.data.category}</span>
          <h3 class="text-xl font-bold mt-3 mb-2 group-hover:text-brand-accent transition-colors">{p.data.title}</h3>
          <p class="text-brand-text-secondary text-sm">{p.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</MainLayout>
